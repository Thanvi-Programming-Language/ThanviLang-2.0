# ThanviLang 2.0 WebApp

app "Thanvi WebApp"

route "/" {
    title "ThanviLang 2.0"
    heading "Welcome to ThanviLang"
    text "Build modern web apps using Thanvi Programming Language."
    button "Get Started"
}

route "/about" {
    title "About ThanviLang"
    heading "Thanvi Programming Language"
    text "ThanviLang is a Python-based programming language."
    button "Home"
}

start()
